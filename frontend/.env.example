# Base URL of the deployed API Gateway stage (README.md lists the live one).
# Leave unset for local work: the client then serves the committed fixtures and the UI labels
# them DEMO FIXTURE, per the Live -> Cached -> Demo Fixture ladder in PRD §7.2.
VITE_API_BASE_URL=

# Local development only. The deployed stage sends no CORS headers, so a browser on localhost
# cannot call it directly. Setting this turns on the dev-server proxy in vite.config.ts; pair it
# with VITE_API_BASE_URL=/api to exercise the screens against real data locally.
#
#   VITE_DEV_API_ORIGIN=https://vx59qs2osl.execute-api.eu-north-1.amazonaws.com
#   VITE_API_BASE_URL=/api
VITE_DEV_API_ORIGIN=
